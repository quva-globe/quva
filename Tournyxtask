    <!-- Script for PDF Generation -->
    <script>
        function generatePDF() {
            // Hide the download button so it doesn't appear in the PDF
            const btn = document.getElementById('action-buttons');
            btn.style.display = 'none';

            const element = document.getElementById('presentation-content');
            
            const opt = {
                margin:       [10, 0, 10, 0],
                filename:     'Tournyx_Engine_2.0_Master_Blueprint.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, logging: false, backgroundColor: '#090A0F' },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            // Generate PDF and then restore the button
            html2pdf().set(opt).from(element).save().then(() => {
                btn.style.display = 'block';
            });
        }
    </script>
